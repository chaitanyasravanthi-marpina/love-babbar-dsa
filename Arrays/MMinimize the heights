#include <bits/stdc++.h>
using namespace std;
class Solution
{
public:
    int getMinDiff(vector<int> &arr, int k)
    {
        // code here
        int n = arr.size();
        if (n == 1)
            return 0;
        sort(arr.begin(), arr.end());
        int res = arr[n - 1] - arr[0];
        int small = arr[0] + k;
        int large = arr[n - 1] - k;
        for (int i = 0; i < n - 1; i++)
        {
            int minheight = min(small, arr[i + 1] - k);
            int maxheight = min(large, arr[i] + k);

            res = min(res, maxheight - minheight);
        }
        return res;
    }
};